/target
node_modules/
# No leading slash -- every service stages its pre-built binary into its
# own dist/ (services/*/dist/, packaged by that service's Dockerfile),
# not just one at the repo root.
dist/

# tsc -b's incremental state for web/. Purely a local build cache, and it
# embeds absolute paths, so committing it makes every machine's checkout
# differ.
*.tsbuildinfo
