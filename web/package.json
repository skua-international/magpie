{
  "name": "@skua-international/magpie-web",
  "version": "0.0.0-unreleased",
  "description": "magpie's cluster-management web UI -- served by services/gateway under /ui.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "vite": "^7.1.0",
    "@types/qrcode": "^1.5.5",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.0.0",
    "vitest": "^3.2.0"
  }
}
